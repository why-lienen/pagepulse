# ---- AI summary (optional) ----
# Without a key the audit still runs; the AI-written summary is simply skipped.
# Supported providers: deepseek | openai | any OpenAI-compatible endpoint.
# Copy this file to .env.local and fill in your own values. Never put real keys here.
AI_PROVIDER=deepseek
AI_API_KEY=
# Optional overrides (leave blank to use provider defaults):
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# ---- Performance scores (no configuration needed) ----
# Lighthouse always runs for real. Chrome is resolved as:
#   1. CHROME_PATH (if set)
#   2. packaged @sparticuz/chromium  -> Vercel / Lambda / any Linux server
#   3. installed Chrome on this machine
# So visitors never need a key. The Google PageSpeed API is an optional shortcut.
#
# PERF_PROVIDER=local          # force local Lighthouse
# PERF_PROVIDER=pagespeed      # force the Google API
PAGESPEED_API_KEY=
# LIGHTHOUSE_TIMEOUT_MS=120000
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DISABLE_LOCAL_LIGHTHOUSE=1   # never launch Chrome, API-only

# ---- Queue / abuse limits ----
# A Lighthouse run costs ~15s and a few hundred MB of RAM. Tune for your host.
# AUDIT_CONCURRENCY=2        # audits running at once
# AUDIT_QUEUE_MAX=20         # waiting jobs before 503
# AUDIT_JOB_TIMEOUT_MS=180000
# AUDIT_JOB_TTL_MS=600000    # how long a finished report stays pollable
# AUDIT_IP_MAX=8             # audits per IP per minute (429 above)

# ---- Proxy (optional) ----
# Only needed if googleapis.com is unreachable from your network. In local dev
# the app auto-detects common proxy ports (7897 / 7890 / 7891 / 1087 / 1080 ...).
# The same proxy is passed to headless Chrome when it runs Lighthouse locally.
# PSI_PROXY=http://127.0.0.1:7897
